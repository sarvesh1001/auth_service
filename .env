RATE_LIMIT_OTP_PER_PHONE_HOUR=10
RATE_LIMIT_LOGIN_ATTEMPTS_PER_IP_MINUTE=20
RATE_LIMIT_MPIN_ATTEMPTS_PER_USER_HOUR=10

# ============================================
# BUCKETING CONFIGURATION
# ============================================
