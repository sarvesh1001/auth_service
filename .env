KMS_REGION=us-east-1
KMS_ENDPOINT=

# ============================================
# OTP CONFIGURATION - DEVELOPMENT
# ============================================
OTP_LENGTH=6
OTP_EXPIRY_DURATION=5m
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60s
RATE_LIMIT_OTP_SEND_1MIN=5
RATE_LIMIT_OTP_SEND_5MIN=10
RATE_LIMIT_OTP_SEND_HOUR=50
RATE_LIMIT_OTP_VERIFY_30SEC=10
RATE_LIMIT_OTP_VERIFY_MIN=20
OTP_LOCKOUT_THRESHOLD=100
OTP_LOCKOUT_DURATION=5m
OTP_CACHE_TTL=6m
OTP_RATE_LIMIT_CACHE_TTL=1h
SMS_PROVIDER=mock
SMS_ENABLED=false
SMS_API_KEY=dev_mock_key
SMS_API_SECRET=dev_mock_secret
SMS_FROM_NUMBER=+1234567890
SMS_TEMPLATE_ID=dev_template_001
OTP_LOG_IN_DEV=true
OTP_BYPASS_RATE_LIMIT_DEV=false

# Legacy OTP fields (for backward compatibility)
OTP_TTL=300
RATE_LIMIT_OTP_PER_PHONE_MINUTE=2
RATE_LIMIT_OTP_PER_PHONE_HOUR=10
# ============================================
# MPIN CONFIGURATION - DEVELOPMENT
# ============================================
# MPIN Basic Settings
MPIN_MIN_LENGTH=4
MPIN_MAX_LENGTH=8
MPIN_MAX_ATTEMPTS=5
MPIN_LOCK_DURATION=30

# MPIN Rate Limiting
RATE_LIMIT_MPIN_VERIFY_30SEC=10
RATE_LIMIT_MPIN_VERIFY_MIN=15
RATE_LIMIT_MPIN_SETUP_PER_USER_HOUR=3
RATE_LIMIT_MPIN_CHANGE_PER_USER_DAY=5

# MPIN Security Settings
MPIN_REQUIRE_DEVICE_BINDING=true
MPIN_AUTO_UNLOCK_EXPIRED=true
MPIN_LOG_WEAK_ATTEMPTS=true
MPIN_ENFORCE_COMPLEXITY=true

# MPIN Cache Settings
MPIN_CACHE_TTL=10m
MPIN_FAILED_ATTEMPTS_CACHE_TTL=1h

# MPIN Cleanup Settings
MPIN_CLEANUP_INTERVAL=1h
MPIN_CLEANUP_BATCH_SIZE=100

# Development Settings
MPIN_LOG_VERIFICATION_IN_DEV=true
MPIN_BYPASS_COMPLEXITY_DEV=false
MPIN_ALLOW_WEAK_PINS_DEV=false



ENCRYPTION_MASTER_KEY=v1WN3YRCXKS7ehT8hmg5nQZzzWldKC3rB3Oowh/SQeQ=



# Kafka Topics
KAFKA_DEVICE_EVENTS_TOPIC=device-events
KAFKA_OTP_EVENTS_TOPIC=otp-events
KAFKA_LOG_EVENTS_TOPIC=log-events
KAFKA_TOPICS_AUTH_EVENTS=auth-events  // Single topic for all events





# ============================================
# JWT CONFIGURATION - HYBRID TOKEN APPROACH
# ============================================
# JWT Secret (should be at least 32 characters)
JWT_SECRET=7eith5Aeghae1ieVoh0ooHoh9aeSh2eeF1aech4Eing

# Access Token TTL (short-lived, stateless)
JWT_ACCESS_TTL=15m

# Refresh Token TTL (long-lived, stored in Redis)
JWT_REFRESH_TTL=168h  # 7 days

# Signing Method (HS256 for HMAC, RS256 for RSA)
JWT_SIGNING_METHOD=HS256

# Rotate refresh tokens on use (recommended for security)
JWT_ROTATE_REFRESH_TOKENS=true

