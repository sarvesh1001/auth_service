{
    "title": "Device & MPIN Monitoring",
    "uid": "device-mpin-dashboard",
    "tags": ["auth", "device", "mpin"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 6,
    "refresh": "30s",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "timeseries",
        "title": "MPIN Failure Rate (last 7d)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT $__timeGroup(timestamp, 1m) AS time, countIf(status LIKE '%failed%' OR status = 'admin_verification_blocked_untrusted') / count(*) * 100 AS failure_rate FROM mpin_events WHERE $__timeFilter(timestamp) GROUP BY time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        },
        "alert": {
          "alertRuleTags": { "service": "mpin", "severity": "critical" },
          "conditions": [
            {
              "evaluator": { "params": [10], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "1m",
          "handler": 1,
          "name": "High MPIN Failure Rate Alert"
        }
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "timeseries",
        "title": "MPIN P95 Latency (last 7d)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT $__timeGroup(timestamp, 1m) AS time, quantile(0.95)(duration_ms) AS p95 FROM mpin_events WHERE $__timeFilter(timestamp) AND duration_ms > 0 GROUP BY time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 300 },
                { "color": "red", "value": 500 }
              ]
            }
          }
        },
        "alert": {
          "alertRuleTags": { "service": "mpin", "severity": "critical" },
          "conditions": [
            {
              "evaluator": { "params": [500], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "1m",
          "handler": 1,
          "name": "High MPIN Latency Alert"
        }
      },
      {
        "id": 3,
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
        "type": "stat",
        "title": "MPIN Lockouts (last 7d)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT count(*) AS lockouts FROM mpin_events WHERE status='admin_mpin_locked' AND $__timeFilter(timestamp)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 2 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        "alert": {
          "alertRuleTags": { "service": "mpin", "severity": "critical" },
          "conditions": [
            {
              "evaluator": { "params": [5], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "1m",
          "frequency": "1m",
          "handler": 1,
          "name": "MPIN Lockouts Spike"
        }
      },
      {
        "id": 4,
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
        "type": "stat",
        "title": "Device Bind Success Rate (last 7d)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT \n  sumIf(total_events, action='bind_device' AND module='admin_device') \n  / sum(total_events) * 100 AS success_rate\nFROM audit_events_daily\nWHERE module='admin_device'\n  AND $__timeFilter(event_date)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 95 }
              ]
            }
          }
        },
        "alert": {
          "alertRuleTags": { "service": "device", "severity": "warning" },
          "conditions": [
            {
              "evaluator": { "params": [95], "type": "lt" },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "5m",
          "frequency": "1m",
          "handler": 1,
          "name": "Device Bind Success Rate Low"
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "type": "barchart",
        "title": "Daily Active Users (MPIN)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT event_date AS day, sum(unique_users) AS users FROM mpin_events_daily WHERE $__timeFilter(event_date) GROUP BY event_date ORDER BY day",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "type": "piechart",
        "title": "Device Actions Distribution",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT action, sum(total_events) AS count FROM audit_events_daily WHERE module='admin_device' AND $__timeFilter(event_date) GROUP BY action",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
        "type": "timeseries",
        "title": "Device Bindings Trend",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "table",
            "queryType": "raw",
            "rawSql": "SELECT event_date AS time, sum(total_events) AS bindings FROM audit_events_daily WHERE module='admin_device' AND action='bind_device' AND $__timeFilter(event_date) GROUP BY event_date ORDER BY time",
            "refId": "A"
          }
        ]
      }
    ],
    "templating": { "list": [] }
  }