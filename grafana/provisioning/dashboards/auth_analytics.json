{
    "title": "Auth Analytics",
    "uid": "auth-analytics",
    "tags": ["auth", "realtime"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "timeseries",
        "title": "MPIN Failure Rate (last hour)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "time_series",
            "queryType": "raw",
            "rawSql": "SELECT $__timeGroup(timestamp, 1m) AS time, countIf(status LIKE '%failed%' OR status = 'admin_verification_blocked_untrusted') / count(*) * 100 AS failure_rate FROM mpin_events WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        },
        "alert": {
          "alertRuleTags": { "service": "mpin", "severity": "critical" },
          "conditions": [
            {
              "evaluator": { "params": [10], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "1m",
          "handler": 1,
          "name": "High MPIN Failure Rate Alert"
        }
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "timeseries",
        "title": "OTP Failure Rate (last hour)",
        "targets": [
          {
            "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
            "format": "time_series",
            "queryType": "raw",
            "rawSql": "SELECT $__timeGroup(timestamp, 1m) AS time, countIf(status LIKE '%failed%') / count(*) * 100 AS failure_rate FROM otp_events WHERE $__timeFilter(timestamp) GROUP BY time ORDER BY time",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        },
        "alert": {
          "alertRuleTags": { "service": "otp", "severity": "critical" },
          "conditions": [
            {
              "evaluator": { "params": [10], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A"] },
              "reducer": { "params": [], "type": "avg" },
              "type": "query"
            }
          ],
          "executionErrorState": "alerting",
          "for": "2m",
          "frequency": "1m",
          "handler": 1,
          "name": "High OTP Failure Rate Alert"
        }
      }
    ],
    "templating": { "list": [] }
  }